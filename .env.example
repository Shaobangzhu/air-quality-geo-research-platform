# Copy to .env at the repository root. Never put server secrets in VITE_* variables.
PORT=3001
HOST=127.0.0.1
DATA_MODE=sample
# npm run db:setup creates the authorized isolated target and fills these locally.
POSTGRESQL_PORT=55436
DATABASE_URL=
# Set only after confirming this database belongs solely to this project.
DB_TARGET_CONFIRMED=
ALLOW_LIVE_API_TESTS=false
AIRNOW_API_KEY=
# Engineering limits; not AirNow rate-limit guarantees.
BFF_CACHE_TTL_SECONDS=300
BFF_CACHE_STALE_SECONDS=900
UPSTREAM_TIMEOUT_MS=3000
UPSTREAM_MAX_ATTEMPTS=2
AQS_EMAIL=
AQS_API_KEY=
OPENAI_API_KEY=
# Public browser credential by design; restrict referrers and privileges before use.
# Not consumed by the foundation shell.
VITE_ARCGIS_API_KEY=
